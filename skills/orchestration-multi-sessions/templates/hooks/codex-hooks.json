{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-risk-zones.mjs\"",
            "statusMessage": "Checking risk zones"
          }
        ]
      }
    ]
  }
}
